# Copie para .env e preencha os valores. Nunca commitar o .env (ver .gitignore).

# --- Postgres --------------------------------------------------------------
# Usuário/senha compartilhados pelas bases "airflow" (metadados) e "gastos"
# (aplicação), hospedadas no mesmo container Postgres. Obrigatório — sem
# valor aqui, o container do Postgres não sobe.
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Airflow -----------------------------------------------------------------
# UID do usuário do host, para evitar problemas de permissão nos volumes
# montados em dags/ e data/ (Linux/WSL). Rode `id -u` para descobrir o seu.
AIRFLOW_UID=50000
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Obrigatório — o Airflow se recusa a subir sem isso (e bloqueia valores
# default conhecidos, então não há fallback possível no docker-compose.yml).
# Gerar com: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=
# Vazio aqui cai no fallback "admin"/"admin" definido no docker-compose.yml.
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# --- Mercado Livre (OAuth 2.0) ------------------------------------------------
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Usado só na autorização inicial (manual, feita uma vez fora deste
# pipeline, para obter o primeiro refresh_token) — o DAG de ingestão só
# troca refresh_token por access_token e não usa este valor.
MERCADOLIVRE_REDIRECT_URI=
# Valor inicial. Depois da primeira execução do DAG, o refresh_token
# vigente passa a ser lido da tabela oauth_token (ele é rotacionado a
# cada uso) — este valor só é consultado se a tabela ainda estiver vazia.
MERCADOLIVRE_REFRESH_TOKEN=

# --- Classificação (LLM) ------------------------------------------------------
ANTHROPIC_API_KEY=
